*.grib2
*.grib.tmp
*.nc
*.nc4
*.h5
*.hdf5
*.bufr
*.parquet
*.tif
*.tiff
*.zarr/
*.idx

# Local configuration. .env.example is the committed template.
.env
.env.local

# Editor and OS cruft
.DS_Store
.idea/
.playwright-mcp/


# ECMWF MARS retrievals and their staging area. A month of GRIB is tens of
# terabytes and lands next to the provider modules on some machines.
planetary_datasets/providers/*.grib
planetary_datasets/providers/*.grib.tmp
planetary_datasets/providers/mars_grib_index.parquet
mars_staging/
