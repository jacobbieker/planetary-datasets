# Copy to .env and fill in. Real environment variables take precedence over this file,
# so the same settings work under Dagster, in CI and from a shell.
#
# .env is gitignored. Never commit real credentials.

# --- Icechunk output -------------------------------------------------------------------
# Destination bucket and optional prefix for every store.
#
# Two addressing forms reach Source Cooperative. The AWS-hosted bucket:
#     ICECHUNK_BUCKET=us-west-2.opendata.source.coop   (prefixes start bkr/...)
# or source.coop's own endpoint, which most existing stores use:
#     ICECHUNK_BUCKET=bkr
#     ICECHUNK_ENDPOINT_URL=https://data.source.coop
ICECHUNK_BUCKET=us-west-2.opendata.source.coop
ICECHUNK_PREFIX=
# ICECHUNK_ENDPOINT_URL=https://data.source.coop
# Defaults to true whenever an endpoint URL is set. A bucket name containing dots cannot
# be addressed virtual-host style over TLS.
# ICECHUNK_FORCE_PATH_STYLE=true
# ICECHUNK_ALLOW_HTTP=false

# Set this to write every store to a local directory instead of S3. Used by the tests and
# for trying a provider out without touching the public bucket.
# ICECHUNK_LOCAL_PATH=/tmp/planetary-datasets-stores

# --- AWS -------------------------------------------------------------------------------
# Either a named profile (preferred; required for writing to source.coop) or a key pair.
# With neither set, the standard AWS credential chain is used.
AWS_REGION=us-west-2
# AWS_PROFILE=sc
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Local storage ---------------------------------------------------------------------
# Where downloaded inputs and intermediate files live.
PLANETARY_DATASETS_DATA_DIR=./data
PLANETARY_DATASETS_SCRATCH_DIR=/tmp

# --- Memory limits ---------------------------------------------------------------------
# Fraction of currently available RAM a single job may use.
MEMORY_FRACTION=0.8
# Absolute ceiling in GB. Overrides MEMORY_FRACTION when set.
# MEMORY_CEILING_GB=32

# --- Copernicus Marine (CMEMS) ----------------------------------------------------------
# COPERNICUSMARINE_SERVICE_USERNAME=
# COPERNICUSMARINE_SERVICE_PASSWORD=

# --- NASA Earthdata / GPM PPS -----------------------------------------------------------
# EARTHDATA_USERNAME=
# EARTHDATA_PASSWORD=
# GPM_PPS_USERNAME=
# GPM_PPS_PASSWORD=

# --- Copernicus CDS / ADS ---------------------------------------------------------------
# Alternatively configure ~/.cdsapirc, which cdsapi reads directly.
# CDSAPI_URL=https://cds.climate.copernicus.eu/api
# CDSAPI_KEY=

# --- EUMETSAT Data Store ------------------------------------------------------------------
# EUMETSAT_CONSUMER_KEY=
# EUMETSAT_CONSUMER_SECRET=

# --- ECMWF MARS / API ---------------------------------------------------------------------
# Alternatively configure ~/.ecmwfapirc.
# ECMWF_API_URL=https://api.ecmwf.int/v1
# ECMWF_API_KEY=
# ECMWF_API_EMAIL=

# --- Hugging Face Hub -----------------------------------------------------------------------
# HF_TOKEN=
# HF_REPO_ID=

# --- Destination Earth ----------------------------------------------------------------------
# DESTINE_PAT=

# --- ESA VirES (Aeolus / Swarm) ---------------------------------------------------------------
# VIRES_TOKEN=

# --- MeteoSwiss KENDA-CH1 ------------------------------------------------------------------
# The nwp/kenda_download asset runs this image (docker/meteoswiss-kenda/build.sh) and mounts
# <PLANETARY_DATASETS_DATA_DIR>/meteoswiss into it. The OGD API needs no credentials.
# METEOSWISS_KENDA_IMAGE=planetary-datasets/meteoswiss-kenda:latest

# --- earth2studio sources (OPERA radar, direct observations) -------------------------------
# The radar/opera_*_download and earth2studio_obs/*_download assets run this image
# (docker/earth2studio/build.sh). Staged partitions are deleted once they are published.
# The EUMETSAT sources (MetOp, MTG FCI/LI) also need EUMETSAT_CONSUMER_KEY/SECRET above.
# EARTH2STUDIO_IMAGE=planetary-datasets/earth2studio:latest
# OPERA_ARCHIVE_DIR=./data/opera
# E2S_OBS_ARCHIVE_DIR=./data/earth2studio

# --- Dagster --------------------------------------------------------------------------------
# DAGSTER_HOME=~/.dagster
